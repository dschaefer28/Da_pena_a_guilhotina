--- !u!114 &7657567633651206077
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6037214752926246677}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ac758d05b275614fae39eb16bf2813d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Fase1Desfecho
  forcarRepetir: 0
  etapaGatilho: mesa_de_casos
  legendas:
  - texto: Paris, 1780. O panfleto sobre o caso Bradier circula pelas ruas antes
      do amanhecer.
    duracao: 5
  - texto: "Nas tavernas, o povo l\xEA em voz alta. Nos sal\xF5es, o Estado toma
      nota do nome da tipografia."
    duracao: 5
  - texto: "Cada p\xE1gina impressa agora tem um pre\xE7o. E algu\xE9m sempre paga."
    duracao: 4
--- !u!114 &2026820043679994935
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6037214752926246677}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a5431a2b7b40a644bcf747982e4f640, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCutscene
  forcarRepetir: 0
  legendas:
  - texto: Paris, 1780. Nove anos antes da Queda da Bastilha.
    duracao: 4
  - texto: "Nas ruas, o descontentamento cresce em sil\xEAncio \u2014 e a palavra
      impressa j\xE1 circula mais r\xE1pido que os editos do rei."
    duracao: 5
  - texto: "Numa pequena tipografia, um novo aprendiz est\xE1 prestes a descobrir
      o poder de uma p\xE1gina bem escrita."
    duracao: 5
--- !u!114 &6134696014951055631
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6037214752926246677}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65b331b7aa68280449a5bdaf22b25948, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FimDeFase
  cenaDoEscritorio: Jogo
  textoDespesas: "Fim do per\xEDodo. Aluguel, papel e tinta custaram {0} moedas \xE0
    tipografia."
  textoDivida: "Sem dinheiro para tudo, voc\xEA agora deve aos credores, e eles v\xE3o
    cobrar em tempo."
  introducaoRevelacoes: "Alguns dias depois, a verdade chega \xE0s ruas de Paris."
  textoPadraoRevelacao: "O panfleto sobre o {0} foi desmentido. A tipografia perdeu
    a confian\xE7a de quem o leu."
  cutscenes:
  - fase: 2
    legendas:
    - texto: "Paris, 1789. A Bastilha caiu, e os panfletos da tipografia correm de
        m\xE3o em m\xE3o."
      duracao: 5
    - texto: "O nome da casa j\xE1 \xE9 conhecido nas ruas. E nos gabinetes."
      duracao: 4
  - fase: 3
    legendas:
    - texto: "1793. O Terror governa a Fran\xE7a, e o Tribunal Revolucion\xE1rio
        n\xE3o descansa."
      duracao: 5
    - texto: "Tudo o que foi impresso at\xE9 aqui ser\xE1 lembrado. Por uns, como
        coragem. Por outros, como trai\xE7\xE3o."
      duracao: 5
