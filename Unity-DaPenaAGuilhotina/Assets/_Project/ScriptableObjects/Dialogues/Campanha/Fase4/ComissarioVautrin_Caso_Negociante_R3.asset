  talkScript:
  - name: Mercador
    text: "Alguns s\xE3o sementes, juro. O resto \xE9 farinha do fornecedor, que
      me paga o aluguel do por\xE3o. Eu s\xF3 guardo a chave."
    dialogueAudio:
      Guid:
        Data1: -922102975
        Data2: 1274908470
        Data3: 619609240
        Data4: 476546802
      Path: event:/P1Normal
    choices: []
  - name: Mercador
    text: "Tome as faturas e veja com seus pr\xF3prios olhos."
    dialogueAudio:
      Guid:
        Data1: -922102975
        Data2: 1274908470
        Data3: 619609240
