  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: ViuvaFrancois_Caso_ChampDeMars
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: "M\xE9dico"
    text: "Depois do Champ de Mars, tratei dois guardas com a cabe\xE7a aberta por
      pedradas."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: "M\xE9dico"
    text: "Eles juram que no altar n\xE3o se assinava peti\xE7\xE3o nenhuma: Danton
      mandou armar o povo, e a folha de assinaturas foi escrita depois, para disfar\xE7ar
      a insurrei\xE7\xE3o."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices: []
  - name: "M\xE9dico"
    text: "Os Cordeliers pregaram artigos da Constitui\xE7\xE3o no mural, e algu\xE9m
      deixou um bilhete sobre a lei na mesa do caf\xE9. Cada um conta de um jeito."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices:
    - choiceText: "O senhor viu algum peticion\xE1rio armado?"
      nextDialogue: {fileID: 11400000, guid: 0fee315acbdf17b4a8e0805ec99cff28, type: 2}
    - choiceText: Por que o senhor acredita nos guardas?
      nextDialogue: {fileID: 11400000, guid: dd4b74e371f190e459c6b39514a12c0e, type: 2}
