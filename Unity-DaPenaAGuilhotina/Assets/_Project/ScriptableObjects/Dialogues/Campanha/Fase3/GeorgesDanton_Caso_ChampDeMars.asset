--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: GeorgesDanton_Caso_ChampDeMars
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Georges Danton
    text: "Dizem que incitei a insurrei\xE7\xE3o armada. Tolice! Eu apenas usei a
      voz que a Constitui\xE7\xE3o me deu."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: Georges Danton
    text: "Quem assinava no altar da p\xE1tria n\xE3o carregava fuzil. Procure os
      sobreviventes: um deles guardou a peti\xE7\xE3o."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: Georges Danton
    text: "E desconfie do m\xE9dico da esquina: anda repetindo o que os guardas feridos
      lhe contam."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices: []
  - name: Georges Danton
    text: "Valois, voc\xEA consegue convencer o j\xFAri de que a lei protege a voz
      das ruas?"
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices:
    - choiceText: "A Constitui\xE7\xE3o de 1791 garante o direito de peti\xE7\xE3o.
        Vou focar na legalidade t\xE9cnica do seu ato."
      nextDialogue: {fileID: 11400000, guid: 26bebc200da5f89409b900cd537e6954, type: 2}
    - choiceText: "Se atacarmos Lafayette e o prefeito Bailly, o senhor ter\xE1 ainda
        mais inimigos."
      nextDialogue: {fileID: 11400000, guid: 67a738b53b4aebc42950ba0089372419, type: 2}
    - choiceText: "Por que o senhor n\xE3o se apresenta e se defende no tribunal?"
      nextDialogue: {fileID: 11400000, guid: 57ae423051e18734498f951dca60122d, type: 2}
