  talkScript:
  - name: Georges Danton
    text: Escolha bem as palavras. Um advogado medroso usa a lei como escudo; um
      mestre usa a lei como espada para derrubar tiranos.
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: Georges Danton
    text: "Os artigos est\xE3o pregados no mural dos Cordeliers. Leia antes que algu\xE9m
      os arranque."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices: []
