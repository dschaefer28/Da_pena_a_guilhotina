  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: GeorgesDanton_Caso_Varennes
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Georges Danton
    text: "O banqueiro Kornmann? Todo o caf\xE9 comenta que ele mesmo escreveu o
      di\xE1rio da mulher, imitando a letra dela, para ganhar o div\xF3rcio e ficar
      com o dote."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: Georges Danton
    text: "Algu\xE9m esqueceu na mesa do caf\xE9 um m\xE9moire do Beaumarchais sobre
      o caso, e na caixa de tipos est\xE3o compondo um libelo contra o banqueiro.
      Leia os dois e ria comigo."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices:
    - choiceText: "O senhor leu o di\xE1rio?"
      nextDialogue: {fileID: 11400000, guid: 27ffcde5f0c60e64493c4ee4bc14cdc8, type: 2}
    - choiceText: Por que Paris se importa com o casamento de um banqueiro?
      nextDialogue: {fileID: 11400000, guid: 1551a46e9a35b524f85b3518b2eb164a, type: 2}
