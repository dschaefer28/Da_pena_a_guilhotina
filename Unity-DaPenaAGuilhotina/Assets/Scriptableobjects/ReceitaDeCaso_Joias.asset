  comBoato:
    panfleto: {fileID: 0}
    povo: 70
    estado: -20
    ouro: 35
    textoRevelacao: 'Soube-se que a Rainha nunca encomendou o colar em segredo: o
      boato impresso pela tipografia caiu por terra.'
    penalidadePovo: -30
    penalidadeEstado: -5
  calunia:
    panfleto: {fileID: 0}
    povo: 90
    estado: -30
    ouro: 50
    textoRevelacao: "O libelo contra a Rainha e o Cardeal n\xE3o tinha prova alguma.
      A tipografia \xE9 chamada de caluniadora."
