  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &780209767
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 780209766}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b5b9aa55f25898548bd9806b346c4604, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  forcarReiniciar: 1
  etapas:
  - etapaId: boas_vindas
    mensagem: "Bem-vindo ao seu primeiro dia no escrit\xF3rio! Vamos te mostrar rapidinho
      como tudo funciona."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: Joystick
    mensagem: "Este \xE9 o joystick. Use-o para se movimentar pelo escrit\xF3rio.
      Depois de experimentar, toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: Personagem
    mensagem: "Caminhe at\xE9 o primeiro personagem indicado. Quando estiver perto
      dele, toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: explica_interacao
    mensagem: "Perto do primeiro personagem, aperte o bot\xE3o de intera\xE7\xE3o
      e converse com ele at\xE9 o fim."
    icone: {fileID: 0}
    tipoDeAvanco: 1
    nomeDoEvento: dialogo_finalizado
    nomeDaCena: 
  - etapaId: falar_segunda_personagem
    mensagem: "Agora v\xE1 at\xE9 a segunda personagem e interaja com ela. Termine
      a conversa para receber o primeiro item."
    icone: {fileID: 0}
    tipoDeAvanco: 1
    nomeDoEvento: item_recebido
    nomeDaCena: 
  - etapaId: InventoryButton
    mensagem: "Voc\xEA recebeu o primeiro item! Aperte o bot\xE3o do invent\xE1rio
      para abri-lo."
    icone: {fileID: 0}
    tipoDeAvanco: 1
    nomeDoEvento: inventario_alternado
    nomeDaCena: 
  - etapaId: ver_item_inventario
    mensagem: "Aqui est\xE1 o item que voc\xEA recebeu. O invent\xE1rio guarda suas
      pistas e materiais. Observe o item e toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: fechar_inventario
    mensagem: "Aperte novamente o bot\xE3o do invent\xE1rio para fech\xE1-lo e voltar
      ao escrit\xF3rio."
    icone: {fileID: 0}
    tipoDeAvanco: 1
    nomeDoEvento: inventario_alternado
    nomeDaCena: 
  - etapaId: PauseButton
    mensagem: "Este \xE9 o bot\xE3o de pause. Ele abre o menu de pausa e as op\xE7\xF5es.
      Voc\xEA pode abrir o menu e retomar o jogo. Depois, toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: segunda_pista
    mensagem: Volte ao primeiro personagem e converse com ele novamente para receber
      o segundo item.
    icone: {fileID: 0}
    tipoDeAvanco: 1
    nomeDoEvento: item_recebido
    nomeDaCena: 
  - etapaId: ir_para_porao
    mensagem: "Com os dois itens no invent\xE1rio, v\xE1 at\xE9 o al\xE7ap\xE3o e
      interaja com ele para descer ao por\xE3o."
    icone: {fileID: 0}
    tipoDeAvanco: 2
    nomeDoEvento: 
    nomeDaCena: Porao
  - etapaId: explicar_prensa
    mensagem: "Voc\xEA chegou ao por\xE3o! Aproxime-se da prensa e use o bot\xE3o
      de intera\xE7\xE3o para abri-la. Depois, toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: colocar_itens_prensa
    mensagem: "Toque em um item do invent\xE1rio e depois em um slot de entrada da
      prensa. Repita com o outro item no segundo slot. Depois, toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: misturar_itens
    mensagem: "Com um item em cada slot de entrada, aperte o bot\xE3o de misturar.
      Quando o panfleto aparecer no resultado, toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: coletar_resultado_prensa
    mensagem: "O panfleto est\xE1 no slot de resultado da prensa. Toque nele para
      peg\xE1-lo e depois em um slot vazio do invent\xE1rio para guard\xE1-lo. S\xF3
      ent\xE3o toque em Continuar."
    icone: {fileID: 0}
    tipoDeAvanco: 0
    nomeDoEvento: 
    nomeDaCena: 
  - etapaId: voltar_escritorio
    mensagem: "Com o panfleto guardado, feche a prensa e o invent\xE1rio. V\xE1 at\xE9
      a sa\xEDda do por\xE3o e interaja para subir ao escrit\xF3rio."
    icone: {fileID: 0}
    tipoDeAvanco: 2
    nomeDoEvento: 
    nomeDaCena: Jogo
