--- !u!114 &1916742305
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1916742304}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b0d627e057d78848b7b9d60c332325c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TribunalManager
  rotaDeTeste: 1
  reuAbsolvidoDeTeste: 1
  juizes:
  - nome: Robespierre
    retrato: {fileID: 0}
  - nome: Saint-Just
    retrato: {fileID: 0}
  - nome: Couthon
    retrato: {fileID: 0}
  maxArgumentos: 5
  duracaoDaBarra: 0.8
  reacoesFavoraveis:
  - '{juiz}: Hm. Isso pesa a favor do acusado.'
  - "{juiz}: A prova \xE9 s\xF3lida. Prossiga, cidad\xE3o."
  - '{juiz} anota algo e acena devagar.'
  reacoesNeutras:
  - "{juiz}: J\xE1 ouvimos isso antes. Adiante."
  - "{juiz} troca um olhar com os outros ju\xEDzes, sem dizer nada."
  reacoesHostis:
  - "{juiz}: Palavras bonitas n\xE3o salvam ningu\xE9m neste tribunal."
  - "{juiz}: Cuidado, impressor. Defender traidores tamb\xE9m \xE9 trair."
  - "Murm\xFArios na galeria. {juiz} bate o martelo, impaciente."
  argumentosReserva:
  - "Um apelo em nome da Revolu\xE7\xE3o"
  abertura:
  - texto: "Paris, 1793. Sal\xE3o do Tribunal Revolucion\xE1rio."
    duracao: 4
  - texto: "Na bancada, os homens do Comit\xEA. Na galeria, o povo, que veio assistir."
    duracao: 5
  - texto: "Cada prova que voc\xEA apresentar ser\xE1 pesada. E cada palavra, lembrada."
    duracao: 4
  desfechos:
  - rota: 1
    titulo: 'Final A: A Guilhotina'
    vereditoReuAbsolvido: "{juiz}: As provas inocentam o acusado, e ele est\xE1 livre.
      Mas quem o defendeu com tanto fervor serve a outros senhores. Prendam o impressor!"
    vereditoReuCondenado: "{juiz}: Basta! Quem defende os inimigos da Revolu\xE7\xE3o
      \xE9 um deles. Prendam tamb\xE9m o impressor!"
    legendaReuAbsolvido: "O r\xE9u deixa o tribunal livre, gra\xE7as ao seu panfleto.
      Voc\xEA n\xE3o sai."
    legendaReuCondenado: "O r\xE9u sobe \xE0 carro\xE7a antes de voc\xEA. Suas palavras
      n\xE3o bastaram para salv\xE1-lo."
    legendas:
    - texto: "Na mesma noite, a tipografia \xE9 lacrada e seus panfletos queimam
        na pra\xE7a."
      duracao: 5
    - texto: "Ao amanhecer, uma carro\xE7a o leva at\xE9 a Place de la R\xE9volution."
      duracao: 5
    - texto: "A l\xE2mina cai. Suas palavras continuam nas ruas; voc\xEA, n\xE3o."
      duracao: 5
  - rota: 2
    titulo: 'Final B: O Tirano'
    vereditoReuAbsolvido: "{juiz}: As provas s\xE3o claras, e o Comit\xEA reconhece
      seus servi\xE7os, cidad\xE3o. O acusado est\xE1 livre. Por ora."
    vereditoReuCondenado: "{juiz}: O Comit\xEA reconhece seus servi\xE7os, cidad\xE3o.
      Quanto ao acusado, o tribunal decidir\xE1 conforme o interesse da Rep\xFAblica."
    legendaReuAbsolvido: "O r\xE9u \xE9 absolvido. O Comit\xEA tolera a sua defesa,
      porque voc\xEA ainda lhe \xE9 \xFAtil."
    legendaReuCondenado: "O r\xE9u \xE9 condenado para agradar o Estado. Ningu\xE9m
      pergunta o que voc\xEA achava justo."
    legendas:
    - texto: "Nas semanas seguintes, o Comit\xEA encomenda \xE0 sua prensa editais,
        listas e den\xFAncias."
      duracao: 5
    - texto: "Voc\xEA sobrevive e enriquece. Cada cabe\xE7a que rola paga um pouco
        do seu conforto."
      duracao: 5
  - rota: 3
    titulo: 'Final C: O Esquecido'
    vereditoReuAbsolvido: "{juiz}: O acusado est\xE1 livre. Quanto ao impressor:
      nem o povo o defende, nem o Comit\xEA o teme. Pr\xF3ximo caso."
    vereditoReuCondenado: "{juiz}: O acusado est\xE1 condenado. Quanto ao impressor:
      nem o povo o defende, nem o Comit\xEA o teme. Pr\xF3ximo caso."
    legendaReuAbsolvido: "O r\xE9u \xE9 solto. Ningu\xE9m lembra quem escreveu a
      defesa."
    legendaReuCondenado: "O r\xE9u \xE9 condenado, e o seu panfleto \xE9 esquecido
      como voc\xEA."
    legendas:
    - texto: "Ningu\xE9m o condena. Ningu\xE9m o defende. O processo \xE9 arquivado
        sem assinatura."
      duracao: 5
    - texto: Os panfletos da tipografia deixam de circular, e os leitores passam
        a outros nomes.
      duracao: 5
    - texto: "Voc\xEA imprimiu milhares de p\xE1ginas. Nenhuma delas guardou o seu
        nome."
      duracao: 5
  cenaDoMenu: menu principal
  fonte: {fileID: 11400000, guid: ee04d5259065b2044842c83f67f097c3, type: 2}
  fundo: {fileID: 0}
