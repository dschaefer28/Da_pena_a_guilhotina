  m_Name: Caso_Operario
  m_EditorClassIdentifier: Assembly-CSharp::CaseData
  caseTitle: "O Oper\xE1rio Acusado"
  caseDescription: "Abril de 1789. Um oper\xE1rio do faubourg Saint-Antoine sobreviveu
    ao massacre na manufatura de R\xE9veillon e agora \xE9 procurado por participar
    do levante. Ele diz que a multid\xE3o s\xF3 pedia p\xE3o e sal\xE1rio, e que
    a Guarda Francesa atirou para matar. Ele pede ajuda para escapar da condena\xE7\xE3o."
  objectiveText: "Descobrir como a Guarda agiu contra a multid\xE3o e o que sustenta
    a acusa\xE7\xE3o contra o oper\xE1rio."
  moneyReward: 30
  publicOpinionReward: 10
  stateOpinionReward: -5
  fase: 2
  rota: 0
  horasDeInvestigacao: 0
  npcDialogueRoute: {fileID: 11400000, guid: b4c2cea48397acf48a53804e9fda36e7, type: 2}
