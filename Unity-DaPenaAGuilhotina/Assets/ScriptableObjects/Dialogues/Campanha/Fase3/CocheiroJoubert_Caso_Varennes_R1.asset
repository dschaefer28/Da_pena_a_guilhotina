  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: CocheiroJoubert_Caso_Varennes_R1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Guillaume Kornmann
    text: Beaumarchais! Aquele saltimbanco meteu o nariz no meu casamento e ainda
      escreveu sobre isso.
    dialogueAudio:
      Guid:
        Data1: -1800404600
        Data2: 1291553084
        Data3: -2072599661
        Data4: 407837240
      Path: event:/P1Reclamar
    choices: []
  - name: Guillaume Kornmann
    text: "A autoridade deles j\xE1 est\xE1 podre. Um panfleto bem escrito ser\xE1
      o empurr\xE3o que falta para o povo odi\xE1-los tanto quanto eu os odeio."
    dialogueAudio:
      Guid:
        Data1: -922102975
        Data2: 1274908470
        Data3: 619609240
        Data4: 476546802
      Path: event:/P1Normal
    choices: []
