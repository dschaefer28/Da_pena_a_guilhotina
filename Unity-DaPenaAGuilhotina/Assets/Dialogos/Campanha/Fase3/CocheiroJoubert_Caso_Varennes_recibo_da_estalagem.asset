  talkScript:
  - name: Cocheiro Joubert
    text: "O depoimento do mestre de posta! Ent\xE3o o senhor j\xE1 sabe que eu n\xE3o
      falei com ningu\xE9m."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Cocheiro Joubert
    text: 'Guardei o recibo da estalagem: paguei os cavalos do meu bolso, como qualquer
      cocheiro. Leve.'
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
