  talkScript:
  - name: "M\xE9dico"
    text: "Raz\xE3o... Voltaire escreveu sobre ela a vida inteira, e ainda assim
      queimam livros."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices: []
  - name: "M\xE9dico"
    text: "Tome o laudo. E que Deus, o de qualquer igreja, proteja n\xF3s dois."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
