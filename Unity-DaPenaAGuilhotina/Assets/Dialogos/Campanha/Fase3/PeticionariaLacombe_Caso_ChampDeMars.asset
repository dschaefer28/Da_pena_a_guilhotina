MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: PeticionariaLacombe_Caso_ChampDeMars
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Sobrevivente
    text: "Eles atiraram sem aviso... O papel que carreg\xE1vamos n\xE3o era uma
      arma, era um pedido de socorro \xE0 Na\xE7\xE3o!"
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/NormalFeminino1
    choices: []
  - name: Sobrevivente
    text: "Guardei isso comigo. Est\xE1 manchado, mas \xE9 a prova da nossa inten\xE7\xE3o."
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/NormalFeminino1
    choices:
    - choiceText: "Entregue-me a peti\xE7\xE3o. Vou transform\xE1-la em um grito
        que a Assembleia n\xE3o poder\xE1 ignorar."
      nextDialogue: {fileID: 11400000, guid: 7cc7f3917ad81e944af586d173862871, type: 2}
    - choiceText: "Este papel \xE9 perigoso. Se eu for pego com ele, seremos ambos
        considerados traidores."
      nextDialogue: {fileID: 11400000, guid: 18d503be425caac46982581696019847, type: 2}
    - choiceText: O que acontecia no altar antes dos tiros?
      nextDialogue: {fileID: 11400000, guid: 242599a0d212dfc4d835716fea4713d6, type: 2}
