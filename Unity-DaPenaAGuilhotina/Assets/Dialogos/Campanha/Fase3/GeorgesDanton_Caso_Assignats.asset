  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: GeorgesDanton_Caso_Assignats
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Georges Danton
    text: "Um pai perseguido por ser protestante? A Constitui\xE7\xE3o garante a
      liberdade de culto, cidad\xE3o. Quem julga assim vive no s\xE9culo passado."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: Georges Danton
    text: "Mas desse caso n\xE3o sei mais nada. Tenho os meus pr\xF3prios ju\xEDzes
      atr\xE1s de mim."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices: []
