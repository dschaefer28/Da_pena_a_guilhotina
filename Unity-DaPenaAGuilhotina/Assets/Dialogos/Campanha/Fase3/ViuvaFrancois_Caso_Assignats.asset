  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: ViuvaFrancois_Caso_Assignats
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: "M\xE9dico"
    text: "Vi a jovem \xC9lisabeth depois que saiu do convento. Ela falava com sombras
      e fugia de casa de madrugada... Foi um del\xEDrio, n\xE3o um crime."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: "M\xE9dico"
    text: "Mas, se eu assinar esse laudo, os ju\xEDzes dir\xE3o que sou c\xFAmplice
      de protestantes."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices:
    - choiceText: "A ci\xEAncia forense deve guiar a justi\xE7a. Sua prova pode salvar
        a vida de Pierre-Paul e o patrim\xF4nio da fam\xEDlia."
      nextDialogue: {fileID: 11400000, guid: 4c7b2ccde109544438e01e88b5b01f67, type: 2}
    - choiceText: "Entendo seu medo. Mas sem o seu testemunho, o dogma da Igreja
        vencer\xE1 a raz\xE3o."
      nextDialogue: {fileID: 11400000, guid: 20f404754d3f7ae40a38fbf4f8aa3303, type: 2}
