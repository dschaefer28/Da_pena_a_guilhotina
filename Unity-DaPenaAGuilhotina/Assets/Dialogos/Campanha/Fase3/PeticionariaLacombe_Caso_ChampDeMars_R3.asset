  m_Name: PeticionariaLacombe_Caso_ChampDeMars_R3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Sobrevivente
    text: "Assin\xE1vamos desde a manh\xE3, um de cada vez. Havia mulheres, crian\xE7as,
      gente que s\xF3 sabia fazer uma cruz."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Sobrevivente
    text: "Quando a Guarda chegou, uns rapazes jogaram pedras do barranco. N\xF3s,
      no altar, s\xF3 t\xEDnhamos a pena e o papel. Tome, leve a peti\xE7\xE3o."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
