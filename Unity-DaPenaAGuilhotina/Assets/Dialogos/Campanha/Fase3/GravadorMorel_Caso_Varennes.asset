  talkScript:
  - name: Pierre-Paul Sirven
    text: "Um banqueiro rico que usa a lei contra a pr\xF3pria esposa... e eu, que
      s\xF3 queria enterrar minha filha em paz."
    dialogueAudio:
      Guid:
        Data1: 1101814583
        Data2: 1283210372
        Data3: 1674768279
        Data4: -1519714328
      Path: event:/P3Normal
    choices: []
  - name: Pierre-Paul Sirven
    text: "N\xE3o conhe\xE7o esse senhor Kornmann. N\xE3o posso ajudar."
