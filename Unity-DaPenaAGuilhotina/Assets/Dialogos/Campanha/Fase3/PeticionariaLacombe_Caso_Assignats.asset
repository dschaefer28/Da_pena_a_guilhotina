      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/NormalFeminino1
    choices: []
  - name: Sobrevivente
    text: "N\xE3o conhe\xE7o essa fam\xEDlia, senhor. N\xE3o posso ajudar."
