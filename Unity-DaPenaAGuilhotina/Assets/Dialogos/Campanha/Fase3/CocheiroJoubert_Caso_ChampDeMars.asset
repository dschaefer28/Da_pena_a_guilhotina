  talkScript:
  - name: Guillaume Kornmann
    text: "Danton? Um advogado barulhento que vive de discursos. Os Cordeliers fazem
      barulho; eu fa\xE7o neg\xF3cios."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Guillaume Kornmann
    text: "Do Champ de Mars s\xF3 sei o que os jornais dizem, meu caro. E cada jornal
      diz uma coisa."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
