  talkScript:
  - name: Sobrevivente
    text: "Um banqueiro que briga com a mulher... Enquanto isso, as vi\xFAvas do
      Champ de Mars n\xE3o t\xEAm o que comer."
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/NormalFeminino1
    choices: []
  - name: Sobrevivente
    text: "N\xE3o sei nada disso, senhor. Pergunte a quem frequenta os sal\xF5es."
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
