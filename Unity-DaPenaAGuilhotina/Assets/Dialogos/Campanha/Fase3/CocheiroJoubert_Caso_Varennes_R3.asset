  talkScript:
  - name: Guillaume Kornmann
    text: "Porque at\xE9 setembro a lei n\xE3o permitia. A nova lei me devolve o
      direito que o antigo regime me negou."
    dialogueAudio:
      Guid:
        Data1: -922102975
        Data2: 1274908470
        Data3: 619609240
        Data4: 476546802
      Path: event:/P1Normal
    choices: []
  - name: Guillaume Kornmann
    text: E porque quero que Paris saiba por que precisei dele.
    dialogueAudio:
      Guid:
        Data1: -922102975
        Data2: 1274908470
        Data3: 619609240
        Data4: 476546802
