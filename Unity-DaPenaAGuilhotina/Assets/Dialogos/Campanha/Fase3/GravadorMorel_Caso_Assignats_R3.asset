  talkScript:
  - name: Pierre-Paul Sirven
    text: "Alegre, curiosa, um pouco fr\xE1gil. Levaram-na por ordem do bispo, para
      ser instru\xEDda na f\xE9 cat\xF3lica."
    dialogueAudio:
      Guid:
        Data1: 1101814583
        Data2: 1283210372
        Data3: 1674768279
        Data4: -1519714328
      Path: event:/P3Normal
    choices: []
  - name: Pierre-Paul Sirven
    text: "Quando voltou, falava sozinha e n\xE3o dormia. Eu nunca mais reconheci
      minha filha."
    dialogueAudio:
      Guid:
        Data1: 1101814583
        Data2: 1283210372
        Data3: 1674768279
        Data4: -1519714328
      Path: event:/P3Normal
    choices: []
