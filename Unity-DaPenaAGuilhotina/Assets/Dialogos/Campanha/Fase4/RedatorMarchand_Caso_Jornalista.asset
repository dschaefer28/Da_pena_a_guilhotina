%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: RedatorMarchand_Caso_Jornalista
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Camille Desmoulins
    text: Maximilien foi meu colega de escola... Ele hesitou antes de deixar que
      me chamassem de suspeito.
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/NormalFeminino1
    choices: []
  - name: Camille Desmoulins
    text: "Eu n\xE3o quero derrubar a Rep\xFAblica, Valois, eu quero salv\xE1-la
      de si mesma! Esta lista prova que estamos prendendo inocentes."
    dialogueAudio:
      Guid:
        Data1: -121802520
        Data2: 1137269962
        Data3: 1602447276
        Data4: -1031367414
      Path: event:/ReclamarFeminino1
    choices: []
  - name: Camille Desmoulins
    text: "E Brissot, l\xE1 da pris\xE3o, espalha que eu inventei os nomes. Logo
      ele, que a minha pena ajudou a derrubar."
    dialogueAudio:
      Guid:
        Data1: 745793994
        Data2: 1290263996
        Data3: -404866682
        Data4: -1175277728
      Path: event:/ReclamarFeminino2
    choices:
    - choiceText: "Se Robespierre anotou o seu rascunho, isso prova que h\xE1 ranhuras
        no Comit\xEA. Onde est\xE1 o manuscrito?"
      nextDialogue: {fileID: 11400000, guid: 4977b56831d7eb44887f5c30c3bbdbc3, type: 2}
    - choiceText: "Publicar esta lista de inocentes agora \xE9 declarar guerra aberta
        ao Terror. Voc\xEA est\xE1 pronto para ser o pr\xF3ximo?"
      nextDialogue: {fileID: 11400000, guid: 1776c8d36fe44844e9ccb9a2e0c36488, type: 2}
    - choiceText: "Quem s\xE3o as pessoas da lista?"
      nextDialogue: {fileID: 11400000, guid: 231cd7cc4bfbcfe4e8018319fe655e3e, type: 2}
