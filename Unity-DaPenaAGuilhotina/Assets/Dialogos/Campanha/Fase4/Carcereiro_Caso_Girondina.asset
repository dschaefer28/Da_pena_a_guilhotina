  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: Carcereiro_Caso_Girondina
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Jacques-Pierre Brissot
    text: "Valois, eles nos acusam de federalismo para justificar o Terror. Eles
      n\xE3o querem justi\xE7a, querem sil\xEAncio."
    dialogueAudio:
      Guid:
        Data1: -502641341
        Data2: 1330990861
        Data3: -759013969
        Data4: 473500730
      Path: event:/P3Tristeza
    choices: []
  - name: Jacques-Pierre Brissot
    text: "Voc\xEA ainda acredita que a lei pode vencer o 'Decreto dos Tr\xEAs Dias'
      de Robespierre?"
    dialogueAudio:
      Guid:
        Data1: 1101814583
        Data2: 1283210372
        Data3: 1674768279
        Data4: -1519714328
      Path: event:/P3Normal
    choices:
    - choiceText: "O Estado exige uma condena\xE7\xE3o r\xE1pida. Talvez usar suas
        cartas de prov\xEDncia ajude a acalmar os radicais e salvar sua vida."
      nextDialogue: {fileID: 11400000, guid: 65935d5a85eda4d4ca96cd0ebf923811, type: 2}
    - choiceText: "Se eu imprimir o panfleto 'A Liberdade da Escrita' agora, o povo
        ver\xE1 que este julgamento \xE9 uma farsa."
      nextDialogue: {fileID: 11400000, guid: 64fc6b02e8e180f4c876d8235e6b0abb, type: 2}
