  talkScript:
  - name: Mercador
    text: "O M\xE1ximo? Olhe a tabela na parede de editais: pagam pela farinha menos
      do que custa traz\xEA-la do campo. Quem pode, esconde; quem n\xE3o pode, fecha
      a loja."
    dialogueAudio:
      Guid:
        Data1: -1800404600
        Data2: 1291553084
        Data3: -2072599661
        Data4: 407837240
      Path: event:/P1Reclamar
    choices: []
  - name: Mercador
    text: "Tome as faturas. E cuidado com quem voc\xEA acusa."
    dialogueAudio:
      Guid:
        Data1: -922102975
        Data2: 1274908470
        Data3: 619609240
        Data4: 476546802
      Path: event:/P1Normal
    choices: []
