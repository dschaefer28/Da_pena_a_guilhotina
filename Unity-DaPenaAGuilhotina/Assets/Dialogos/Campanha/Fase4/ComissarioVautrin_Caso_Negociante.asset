%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: ComissarioVautrin_Caso_Negociante
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Mercador
    text: "Cidad\xE3o Valois, eu n\xE3o sou um traidor! Se eu vender o que sobrou,
      n\xE3o haver\xE1 sementes para o amanh\xE3."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Mercador
    text: "O povo me chama de a\xE7ambarcador, mas os verdadeiros lucros est\xE3o
      nos bolsos da elite que me usa como dep\xF3sito!"
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Mercador
    text: "E o jornalista Desmoulins j\xE1 escreveu que a farinha \xE9 minha. Na
      se\xE7\xE3o, ningu\xE9m l\xEA outra coisa."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices:
    - choiceText: "Entregue as faturas. Se provarmos que voc\xEA \xE9 apenas um empregado
        da elite, o \xF3dio da massa ter\xE1 um novo alvo."
      nextDialogue: {fileID: 11400000, guid: b52912b7690b1d14f95a77ca7d64633d, type: 2}
    - choiceText: "Vou atacar as Leis de Abastecimento. O governo prefere prender
        mercadores a admitir que o tabelamento de pre\xE7os falhou."
      nextDialogue: {fileID: 11400000, guid: 806ebc48ff0c1b04b98ac05931f8a2c3, type: 2}
    - choiceText: "Afinal, os sacos s\xE3o sementes ou farinha?"
      nextDialogue: {fileID: 11400000, guid: 563eaaa8aee8d804ea7f4579c0522d4d, type: 2}
