  talkScript:
  - name: Jacques-Pierre Brissot
    text: "Minhas cartas? Leia-as, e depois diga se h\xE1 nelas uma palavra contra
      a Rep\xFAblica. Tome as c\xF3pias."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Jacques-Pierre Brissot
    text: "A Revolu\xE7\xE3o tornou-se um monstro que exige sangue. Se voc\xEA nos
      defender com a verdade, ser\xE1 o vig\xE9simo segundo a subir no cadafalso."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
