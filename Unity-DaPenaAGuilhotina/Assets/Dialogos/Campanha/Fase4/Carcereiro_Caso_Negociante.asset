  talkScript:
  - name: Jacques-Pierre Brissot
    text: "O M\xE1ximo! N\xF3s, girondinos, avisamos que tabelar os pre\xE7os faria
      o trigo sumir dos mercados. Por isso tamb\xE9m nos chamam de inimigos do povo."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Jacques-Pierre Brissot
    text: "Sobre esse mercador, n\xE3o sei nada. Daqui de dentro, s\xF3 vejo o p\xE3o
      encolher."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
