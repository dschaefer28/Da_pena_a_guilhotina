  talkScript:
  - name: "Oper\xE1rio"
    text: "Um colar de diamantes? Com o pre\xE7o de uma pedra s\xF3, o bairro inteiro
      comia um ano."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: "Oper\xE1rio"
    text: "Disso eu n\xE3o sei nada, senhor. S\xF3 sei que o p\xE3o de quatro libras
      j\xE1 custa quase metade do que ganho num dia."
