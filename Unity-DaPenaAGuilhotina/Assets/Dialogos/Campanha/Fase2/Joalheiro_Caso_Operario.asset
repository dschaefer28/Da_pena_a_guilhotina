  talkScript:
  - name: Joalheiro
    text: "O motim do faubourg? Fechei a loja por tr\xEAs dias. Quando a fome sai
      \xE0 rua, joalheiro \xE9 o primeiro a baixar as portas."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/P2Normal
    choices: []
  - name: Joalheiro
    text: "Do oper\xE1rio n\xE3o sei nada, rapaz."
    dialogueAudio:
      Guid:
        Data1: -192394345
        Data2: 1332210459
        Data3: 1556689066
        Data4: 566635019
