  m_Name: Gazeteiro_Caso_Reveillon
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Gazeteiro
    text: "R\xE9veillon? Tenho aqui uma folha que vende como p\xE3o quente."
    dialogueAudio:
      Guid:
        Data1: -922102975
        Data2: 1274908470
        Data3: 619609240
        Data4: 476546802
      Path: event:/Normal geral dois_01
    choices: []
  - name: Gazeteiro
    text: "Diz que no inverno ele cortou pela metade o sal\xE1rio da manufatura e
      mandou a diferen\xE7a para os ingleses. Leve, \xE9 sua."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices:
    - choiceText: Quem escreveu isso?
      nextDialogue: {fileID: 11400000, guid: 283c4a3e844bd1c478608b147eebbfa1, type: 2}
    - choiceText: "E por que os ingleses pagariam R\xE9veillon?"
      nextDialogue: {fileID: 11400000, guid: cb79d6d5096b6af48889ccf2ecee8289, type: 2}
