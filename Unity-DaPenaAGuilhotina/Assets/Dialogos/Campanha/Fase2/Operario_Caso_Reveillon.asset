  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: Operario_Caso_Reveillon
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: "Oper\xE1rio"
    text: "Aquele homem? Disse na assembleia que um oper\xE1rio vive muito bem com
      quinze soldos por dia!"
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: "Oper\xE1rio"
    text: "S\xF3 queria cortar o nosso sal\xE1rio. Do p\xE3o, nem uma palavra."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: "Oper\xE1rio"
    text: Na banca de panfletos vendem uma gazeta com as contas da manufatura, e
      o gazeteiro da esquina tem uma folha ainda pior sobre ele.
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices:
    - choiceText: "Voc\xEA ouviu isso na assembleia?"
      nextDialogue: {fileID: 11400000, guid: 2efb6109c69c7ff4bb22950a49ce4e84, type: 2}
    - choiceText: Por que isso revoltou tanto o bairro?
      nextDialogue: {fileID: 11400000, guid: 8264a95fd907fd342b234365558a68fb, type: 2}
