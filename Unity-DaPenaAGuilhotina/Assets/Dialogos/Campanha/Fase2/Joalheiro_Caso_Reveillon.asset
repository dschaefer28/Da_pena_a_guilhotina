  m_Name: Joalheiro_Caso_Reveillon
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Joalheiro
    text: "R\xE9veillon? Bom cliente. Forra de papel pintado os mesmos sal\xF5es
      que eu enfeito de joias."
    dialogueAudio:
      Guid:
        Data1: -1877086842
        Data2: 1147956126
        Data3: 557338505
        Data4: -1852382703
      Path: event:/Normal geral_01
    choices: []
  - name: Joalheiro
    text: "O que ele disse na assembleia, n\xE3o sei. S\xF3 sei que ningu\xE9m compra
      luxo com o povo gritando por p\xE3o na rua."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
