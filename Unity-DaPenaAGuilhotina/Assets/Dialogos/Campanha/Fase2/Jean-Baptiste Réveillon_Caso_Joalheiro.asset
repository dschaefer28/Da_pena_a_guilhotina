  m_Name: "Jean-Baptiste R\xE9veillon_Caso_Joalheiro"
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: "Jean R\xE9veillon"
    text: "O colar? Um milh\xE3o e seiscentas mil libras em diamantes, rapaz. Eu
      forro de papel pintado os sal\xF5es de Paris e sei quanto vale o luxo."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: "Jean R\xE9veillon"
    text: "Mas quem vendeu e quem comprou, pergunte ao joalheiro. Eu j\xE1 tenho
      problemas demais."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
