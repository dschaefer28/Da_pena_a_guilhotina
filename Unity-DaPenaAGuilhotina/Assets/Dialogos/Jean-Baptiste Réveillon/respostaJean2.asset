  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: respostaJean2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: "Jean R\xE9veillon"
    text: "Eu\u2026 n\xE3o tinha pensado nisso."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Julien Valois
    text: "Se o p\xE3o n\xE3o baixar, quem ganha menos come menos. Foi isso que o
      bairro ouviu."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: "Jean R\xE9veillon"
    text: "Ent\xE3o leve a c\xF3pia da ata da assembleia. Est\xE1 escrito ali o que
      eu propus: o p\xE3o e os sal\xE1rios, juntos."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: "Jean R\xE9veillon"
    text: "E pergunte aos oper\xE1rios o que andam repetindo. Garanto que nenhum
      deles leu a ata."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
