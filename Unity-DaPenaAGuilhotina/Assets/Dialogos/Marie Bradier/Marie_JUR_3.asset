  talkScript:
  - name: Marie Bradier
    text: "N\xE3o sei explicar. Eu n\xE3o estava na casa quando houve o ataque. O
      que n\xE3o entendo \xE9 como uma d\xFAvida dessas acabou numa condena\xE7\xE3o
      \xE0 roda."
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/Normal feminino_01
    choices:
    - choiceText: "Precisamos pedir que expliquem o reconhecimento, sem inventar
        uma explica\xE7\xE3o no lugar deles."
      nextDialogue: {fileID: 11400000, guid: b81fc808942eb8841876a75118ac997f, type: 2}
