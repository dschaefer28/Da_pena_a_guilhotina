        Data4: -1159192161
      Path: event:/Normal feminino_01
    choices:
    - choiceText: "A senhora tamb\xE9m estava com Nicolas?"
      nextDialogue: {fileID: 11400000, guid: 3f0599253630cf747b3e4fc0413d2cf9, type: 2}
    - choiceText: Vamos registrar o que a senhora sabe sobre cada um.
