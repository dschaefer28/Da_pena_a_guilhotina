  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: Mariesequencia2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Julien Valois
    text: Vou reunir os pontos principais antes de levar seu relato a Dupaty. Onde
      estavam seu marido e os outros naquela noite?
    dialogueAudio:
      Guid:
        Data1: 1101814583
        Data2: 1283210372
        Data3: 1674768279
        Data4: -1519714328
      Path: event:/P3Normal
    choices: []
  - name: Marie Bradier
    text: "Meu marido, Charles Bradier, estava em casa, doente. Meu irm\xE3o Jean
      Simare trouxe batata e p\xE3o para ele, e eu fiz uma sopa."
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/Normal feminino_01
    choices: []
  - name: Marie Bradier
    text: Nicolas Lardoise, o amigo deles, estava na casa dele com a esposa e os
      filhos.
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/Normal feminino_01
    choices: []
  - name: Julien Valois
    text: "A senhora relata tamb\xE9m que o reconhecimento demorou meses e que o
      casal n\xE3o parecia seguro. Vou separar essas observa\xE7\xF5es do que a senhora
      presenciou em casa."
    dialogueAudio:
      Guid:
        Data1: 1101814583
        Data2: 1283210372
        Data3: 1674768279
        Data4: -1519714328
      Path: event:/P3Normal
    choices:
    - choiceText: Posso levar esse relato ao meu mestre?
      nextDialogue: {fileID: 11400000, guid: 14039626ac2fd98419e89ccb4593e7bb, type: 2}
