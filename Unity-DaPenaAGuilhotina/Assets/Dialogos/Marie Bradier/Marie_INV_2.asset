  talkScript:
  - name: Marie Bradier
    text: "N\xE3o. Eu estava com meu marido. Nicolas estava na casa dele, com a mulher
      e os filhos. Mas eu n\xE3o estava l\xE1 para ver."
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/Normal feminino_01
    choices:
    - choiceText: "Ent\xE3o preciso distinguir o que a senhora viu do que est\xE1
        me contando sobre ele."
      nextDialogue: {fileID: 11400000, guid: 17e689ed48c47134f81d0a10eb814f90, type: 2}
