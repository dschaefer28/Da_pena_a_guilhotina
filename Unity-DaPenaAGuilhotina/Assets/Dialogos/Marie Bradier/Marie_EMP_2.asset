  m_Script: {fileID: 11500000, guid: e91bcb522deb37a4ab25bed5ecb00d5d, type: 3}
  m_Name: Marie_EMP_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Marie Bradier
    text: "Que meu marido n\xE3o \xE9 apenas um nome numa senten\xE7a. Nem Jean,
      nem Nicolas. Falam dos tr\xEAs como se fossem uma coisa s\xF3. Eu conhe\xE7o
      as pessoas que est\xE3o condenando."
    dialogueAudio:
      Guid:
        Data1: 1666405146
        Data2: 1151074371
        Data3: -921428562
        Data4: -1159192161
      Path: event:/Normal feminino_01
    choices:
    - choiceText: "N\xE3o posso prometer o resultado. Posso levar a s\xE9rio o que
        a senhora tem a dizer."
      nextDialogue: {fileID: 11400000, guid: eb9d581e7ceb66e46964251989d09a89, type: 2}
