  talkScript:
  - name: Joalheiro
    text: "Prova que negociei em nome dela. A autoriza\xE7\xE3o\u2026 eu confiei
      na assinatura e nos intermedi\xE1rios."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Julien Valois
    text: "Vou separar o que est\xE1 registrado do que o senhor presumiu."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: Joalheiro
    text: "Fa\xE7a isso. Leve as duas c\xF3pias."
