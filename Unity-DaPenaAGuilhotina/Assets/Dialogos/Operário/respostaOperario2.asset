  m_Name: respostaOperario2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: "Oper\xE1rio"
    text: "Os guardas n\xE3o queriam afastar a gente, queriam nos matar. Eu n\xE3o
      sei como sobrevivi. Todos os meus companheiros, meus amigos, morreram como
      ratos."
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
  - name: "Oper\xE1rio"
    text: "E agora o R\xE9veillon anda dizendo que \xE9ramos pagos pelo duque de
      Orl\xE9ans. Que diga isso na minha cara!"
    dialogueAudio:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    choices: []
