  talkScript:
  - name: Charles Dupaty
    text: "Nobres protegem nobres, meu jovem. O Parlamento n\xE3o rasgar\xE1 uma
      senten\xE7a para salvar camponeses, a menos que a verdade se torne um esc\xE2ndalo
      p\xFAblico."
    dialogueAudio:
      Guid:
        Data1: 1073101364
        Data2: 1084329749
        Data3: 1909596053
        Data4: -2045081360
      Path: event:/P2Reclamar
    choices:
    - choiceText: O memorial pode obrigar os magistrados a responder?
      nextDialogue: {fileID: 11400000, guid: 097c2427d98038b47a1e596236407742, type: 2}
    - choiceText: "Ent\xE3o precisamos sustentar publicamente o pedido de revis\xE3o."
      nextDialogue: {fileID: 11400000, guid: cec35ce90c196254d8c7d77fa86a150f, type: 2}
