  m_Name: Dupat_INV_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: Charles Dupaty
    text: "Comece separando as coisas. Marie conta o que presenciou em casa e aponta
      d\xFAvidas sobre o reconhecimento. Isso precisa ser examinado. Minha avalia\xE7\xE3o
      das falhas do processo n\xE3o deve ser atribu\xEDda \xE0 boca dela."
    dialogueAudio:
      Guid:
        Data1: -403724050
        Data2: 1276221962
        Data3: 2017058486
        Data4: -235533275
      Path: event:/P2(2)Normal
    choices:
    - choiceText: "Ent\xE3o o relato n\xE3o basta para demonstrar tudo?"
      nextDialogue: {fileID: 11400000, guid: 2d185da366784d548a44b6c7745e72aa, type: 2}
    - choiceText: Precisamos mostrar o que deixou de ser investigado.
      nextDialogue: {fileID: 11400000, guid: cec35ce90c196254d8c7d77fa86a150f, type: 2}
